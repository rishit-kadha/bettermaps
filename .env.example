# BetterMaps Environment Configuration
# Copy this file to .env and insert your Google Maps Android API Key
# 
# How to obtain your key:
# 1. Visit Google Cloud Console: https://console.cloud.google.com/
# 2. Enable "Maps SDK for Android"
# 3. Create Credentials -> API Key
# 4. (Optional) Restrict key to Android apps with package name "com.sih.bettermaps"

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_android_api_key_here
